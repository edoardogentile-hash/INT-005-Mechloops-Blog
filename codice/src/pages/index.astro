---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function getReadingTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Mechloops Blog',
  description: 'Guide pratiche, case study e strategie per PMI italiane che vogliono usare l\'AI per risparmiare tempo e crescere.',
  url: new URL('/blog', Astro.site).toString(),
  publisher: {
    '@type': 'Organization',
    name: 'Mechloops',
    url: 'https://mechloops.com',
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.publishDate.toISOString(),
    url: new URL(`/blog/${post.id}`, Astro.site).toString(),
  })),
};
---

<Layout
  title="Blog"
  description="Guide pratiche, case study e strategie per PMI italiane che vogliono usare l'AI per risparmiare tempo e crescere."
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <!-- Hero -->
    <div class="mb-12">
      <h1 class="font-[var(--font-display)] text-4xl md:text-5xl font-extrabold text-brand-black mb-4">
        Blog
      </h1>
      <p class="text-lg text-brand-gray max-w-2xl">
        Guide pratiche, case study reali e strategie per PMI italiane che vogliono usare l'AI per risparmiare tempo e crescere.
      </p>
    </div>

    <!-- Posts Grid -->
    {posts.length === 0 ? (
      <p class="text-brand-gray text-center py-20">Nessun articolo ancora. Torna presto!</p>
    ) : (
      <div class="grid gap-10 md:grid-cols-2">
        {posts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            category={post.data.category}
            slug={post.id}
            heroImage={post.data.heroImage}
            readingTime={getReadingTime(post.body || '')}
          />
        ))}
      </div>
    )}
  </div>
</Layout>
