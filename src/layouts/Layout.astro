---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'Mechloops — Mini software customizzati e AI Transformation per PMI italiane',
  image = '/blog/og-default.png',
  type = 'website',
  publishDate,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Blog' ? 'Blog — Mechloops' : `${title} — Mechloops Blog`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Edoardo Gentile" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Mechloops" />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

    <!-- JSON-LD -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8B0CW6VSPX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8B0CW6VSPX');
    </script>
  </head>
  <body class="bg-white text-brand-slate font-[var(--font-body)] antialiased">
    <header class="border-b border-brand-light">
      <nav class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="https://mechloops.com" class="flex items-center gap-3 group">
          <img src="/blog/logo.png" alt="Mechloops" class="h-8 w-auto" />
          <span class="font-[var(--font-display)] text-xl font-bold text-brand-black group-hover:text-brand-blue transition-colors">Mechloops</span>
        </a>
        <div class="flex items-center gap-6 text-sm font-medium">
          <a href="/blog" class="text-brand-gray hover:text-brand-black transition-colors">Blog</a>
          <a href="https://mechloops.com/#assessment" class="bg-brand-cyan text-brand-black px-4 py-2 rounded-lg font-semibold hover:brightness-110 transition">
            AI Assessment
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-brand-light mt-20">
      <div class="max-w-4xl mx-auto px-6 py-12">
        <div class="flex flex-col md:flex-row justify-between items-start gap-8">
          <div>
            <a href="https://mechloops.com" class="font-[var(--font-display)] text-lg font-bold text-brand-black">Mechloops</a>
            <p class="text-brand-gray text-sm mt-2 max-w-xs">Mini software customizzati e AI Transformation per PMI italiane.</p>
          </div>
          <div class="flex gap-8 text-sm">
            <div>
              <h4 class="font-semibold text-brand-black mb-3">Risorse</h4>
              <ul class="space-y-2 text-brand-gray">
                <li><a href="/blog" class="hover:text-brand-black transition-colors">Blog</a></li>
                <li><a href="https://mechloops.com/#case-studies" class="hover:text-brand-black transition-colors">Case Studies</a></li>
              </ul>
            </div>
            <div>
              <h4 class="font-semibold text-brand-black mb-3">Contatti</h4>
              <ul class="space-y-2 text-brand-gray">
                <li><a href="https://mechloops.com/#assessment" class="hover:text-brand-black transition-colors">AI Assessment</a></li>
                <li><a href="mailto:edoardo.gentile@mechloops.com" class="hover:text-brand-black transition-colors">Email</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-brand-light text-center text-xs text-brand-gray">
          &copy; {new Date().getFullYear()} Mechloops di Edoardo Gentile. Tutti i diritti riservati.
        </div>
      </div>
    </footer>
  </body>
</html>
